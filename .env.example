# ---- Server ----
PORT=3777
HOST=127.0.0.1            # keep loopback; Tailscale Serve / cloudflared proxy into it
LOG_LEVEL=info
# DATA_DIR=~/Library/Application Support/imessage-assistant   (outbox, cache, logs)
# CHAT_DB=~/Library/Messages/chat.db

# ---- Auth: tailscale | cloudflare | token | none ----
AUTH_MODE=tailscale

# tailscale: identity comes from `tailscale serve` headers. Restrict to your login(s):
TAILSCALE_ALLOWED_LOGINS=you@example.com

# cloudflare: verify the Cloudflare Access JWT.
# CF_ACCESS_TEAM_DOMAIN=yourteam.cloudflareaccess.com
# CF_ACCESS_AUD=<Application Audience (AUD) tag from the Access app>
# CF_ACCESS_ALLOWED_EMAILS=you@example.com

# Optional second factor on top of tailscale/cloudflare (required in AUTH_MODE=token).
# Generate: openssl rand -hex 24
# APP_TOKEN=

# ---- Optional Private API (tapbacks, reply-in-thread, mark read, new groups) ----
# Requires BlueBubbles Server with Private API helper enabled on this Mac.
# BLUEBUBBLES_URL=http://127.0.0.1:1234
# BLUEBUBBLES_PASSWORD=
