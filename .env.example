# ---- Server ----
PORT=3777
# Keep HOST on loopback; Tailscale Serve / cloudflared proxy into it.
HOST=127.0.0.1
LOG_LEVEL=info
# DATA_DIR=~/Library/Application Support/imessage-assistant   (outbox, cache, logs)
# CHAT_DB=~/Library/Messages/chat.db

# ---- Auth: tailscale | cloudflare | token | none ----
AUTH_MODE=tailscale

# tailscale: identity comes from `tailscale serve` headers. Restrict to your login(s):
TAILSCALE_ALLOWED_LOGINS=you@example.com

# cloudflare: verify the Cloudflare Access JWT.
# CF_ACCESS_TEAM_DOMAIN=yourteam.cloudflareaccess.com
# CF_ACCESS_AUD=<Application Audience (AUD) tag from the Access app>
# CF_ACCESS_ALLOWED_EMAILS=you@example.com

# Optional second factor on top of tailscale/cloudflare (required in AUTH_MODE=token).
# Generate: openssl rand -hex 24
# APP_TOKEN=

# ---- Read sync ----
# How to mark conversations read:
#   auto        Private API if configured, otherwise Messages.app UI automation (default)
#   private-api only the Private API
#   ui          only UI automation
#   off         disabled
# UI automation needs this server's node binary added to
# System Settings > Privacy & Security > Accessibility, and it brings Messages.app to the
# front on the Mac each time. Works for one-to-one chats; group chats are not supported yet.
MARK_READ_METHOD=auto

# ---- Attachment staging ----
# Outgoing files must be staged where BOTH Messages.app and its upload helper can read them.
# The default below is the only location verified to work end-to-end on macOS 27. Don't change it
# unless you have tested that attachments actually arrive.
# UPLOAD_STAGING_DIR=~/Library/Messages/imessage-assistant-outbox

# ---- Optional Private API (tapbacks, reply-in-thread, mark read, new groups) ----
# Requires BlueBubbles Server with Private API helper enabled on this Mac.
# BLUEBUBBLES_URL=http://127.0.0.1:1234
# BLUEBUBBLES_PASSWORD=
